    <!-- Mobile Bottom NavBar (Visible only on small screens) -->
    <nav
        class="md:hidden fixed bottom-0 left-0 right-0 bg-sky-50/70 backdrop-blur-xl px-6 py-4 flex justify-between items-center z-50">
        <div class="flex flex-col items-center gap-1 text-sky-600">
            <span class="material-symbols-outlined">explore</span>
            <span class="text-[10px]">Khám phá</span>
        </div>
        <div class="flex flex-col items-center gap-1 text-sky-600">
            <span class="material-symbols-outlined">favorite</span>
            <span class="text-[10px]">Yêu thích</span>
        </div>
        <div class="flex flex-col items-center gap-1 text-sky-900 font-bold">
            <span class="material-symbols-outlined">person</span>
            <span class="text-[10px]">Tài khoản</span>
        </div>
        <div class="flex flex-col items-center gap-1 text-sky-600">
            <span class="material-symbols-outlined">shield_lock</span>
