                                alt="Avatar preview"
                                class="w-48 h-48 rounded-full object-cover shadow-2xl border-4 border-white transition-transform duration-500 group-hover:scale-105 group-hover:shadow-[0_20px_40px_rgba(0,0,0,0.12)]">
