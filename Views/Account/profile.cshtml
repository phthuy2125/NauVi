                            </div>
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-on-surface-variant ml-4">Mật khẩu mới</label>
                                <div class="relative group">
                                    <span
                                        class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">lock</span>
                                    <input id="edit-password"
                                        class="w-full pl-12 pr-12 py-3 bg-surface-container-low border-none rounded-full focus:ring-2 focus:ring-primary-fixed-dim/30 transition-all text-on-surface"
