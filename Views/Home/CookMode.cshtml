@{
    ViewData["Title"] = "Trợ lý Nấu ăn";
}

<!-- Immersive Hero Header -->
<div class="relative w-full h-[500px] rounded-bl-[4rem] overflow-hidden -mt-20">
    <img id="cook-img" alt="Hình ảnh món ăn" class="absolute inset-0 w-full h-full object-cover" src="https://via.placeholder.com/1200x800?text=Đang+tải..."/>
    <div class="absolute inset-0 bg-gradient-to-t from-[#003345]/90 via-[#003345]/50 to-transparent"></div>
    <div class="absolute bottom-0 left-0 w-full p-12 max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-end gap-8">
        <div class="text-white z-10">
            <nav class="flex items-center gap-2 text-sm text-sky-200 mb-4 font-medium uppercase tracking-wider">
                <span>Công thức</span>
                <span class="material-symbols-outlined text-xs">chevron_right</span>
                <span id="cook-category">Món chính</span>
            </nav>
            <h2 class="text-6xl md:text-7xl font-black tracking-tighter leading-tight mb-6">Trợ lý Nấu ăn:<br/><span id="cook-title" class="text-primary-container">Đang tải...</span></h2>
            <div class="flex flex-wrap gap-6">
                <div class="bg-white/10 border border-white/20 text-white px-6 py-4 rounded-full flex items-center gap-3 backdrop-blur-xl">
                    <span class="material-symbols-outlined text-primary-container">schedule</span>
                    <span id="header-time" class="font-bold">45 phút</span>
                </div>
                <div class="bg-white/10 border border-white/20 text-white px-6 py-4 rounded-full flex items-center gap-3 backdrop-blur-xl">
                    <span class="material-symbols-outlined text-secondary-container">group</span>
                    <span id="header-serving" class="font-bold">2 - 4 người</span>
                </div>
                <div class="bg-white/10 border border-white/20 text-white px-6 py-4 rounded-full flex items-center gap-3 backdrop-blur-xl">
                    <span class="material-symbols-outlined text-tertiary-container">restaurant</span>
                    <span class="font-bold">Trung bình</span>
                </div>
            </div>
        </div>
        <div class="flex gap-3 z-10">
            <button class="flex items-center gap-2 px-6 py-4 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur-md text-white font-bold transition-all border border-white/30">
                <span class="material-symbols-outlined">share</span>
                Chia sẻ
            </button>
            <button id="btn-save-recipe" class="flex items-center gap-2 px-6 py-4 rounded-full bg-secondary-container text-on-secondary-container font-bold shadow-lg hover:scale-105 transition-all" onclick="toggleFavoriteCurrent()">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">favorite</span>
                Lưu công thức
            </button>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-10 py-16">
    <!-- Split Layout -->
    <div class="flex flex-col lg:flex-row gap-12">
        <!-- Left Sidebar: Ingredients -->
        <div class="w-full lg:w-1/3">
            <div class="sticky top-32 bg-white/80 backdrop-blur-2xl rounded-3xl p-8 shadow-[0_20px_40px_-15px_rgba(0,100,121,0.1)] border border-white/50">
                <h3 class="text-2xl font-black text-on-surface mb-8 flex items-center gap-3 border-b border-surface-container-highest pb-6">
                    <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary">shopping_basket</span>
                    </div>
                    Nguyên liệu
                </h3>
                <div id="cook-ingredients" class="space-y-4">
                    <!-- JS populated -->
                </div>
                <button class="mt-8 w-full py-4 rounded-full border-2 border-dashed border-outline-variant text-outline hover:border-primary hover:text-primary hover:bg-surface transition-all font-bold text-base">
                    + Thêm nguyên liệu khác
                </button>
            </div>
        </div>

        <!-- Right Main Area: Steps -->
        <div class="w-full lg:w-2/3 space-y-12">
            <!-- Step 1 -->
            <div class="bg-surface-container-lowest rounded-[2.5rem] p-10 shadow-[0_20px_40px_-15px_rgba(0,100,121,0.1)] relative overflow-hidden group">
                <div class="absolute -top-10 -right-10 text-[200px] font-black text-surface-container-low opacity-50 select-none z-0">1</div>
                <div class="relative z-10 flex flex-col gap-6">
                    <div class="flex items-center gap-6 mb-2">
                        <div class="h-16 w-16 rounded-full bg-gradient-to-br from-primary to-primary-container text-on-primary flex items-center justify-center font-black text-3xl shadow-lg">1</div>
                        <h4 class="text-3xl font-black text-on-surface tracking-tight">Sơ chế nguyên liệu</h4>
                    </div>
                    <div class="flex flex-col md:flex-row gap-8">
                        <div class="flex-grow">
                            <p id="step1-desc" class="text-lg text-on-surface-variant leading-relaxed mb-6 font-medium">
                                Rửa sạch tất cả các thành phần tươi sống, làm sạch thịt nếu có. Cắt gọt và phân loại rõ ràng các nhóm nguyên liệu để tiện lợi cho việc nấu nướng.
                            </p>
                            <div class="bg-surface-container-low border border-surface-variant p-5 rounded-2xl flex items-center gap-4">
                                <div class="h-12 w-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                                    <span class="material-symbols-outlined">timer</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Thời gian chuẩn bị</p>
                                    <span id="step1-time" class="font-black text-2xl text-on-surface">15:00</span>
                                </div>
                                <button id="step1-timer-btn" onclick="togglePrepTimer()" class="ml-auto px-6 py-3 rounded-full bg-primary text-on-primary font-bold shadow-md hover:scale-105 active:scale-95 transition-all">
                                    Bật bộ đếm
                                </button>
                            </div>
                        </div>
                        <!-- Ảnh sơ chế: được điền từ trường prepImageUrl trong MongoDB -->
                        <div class="w-full md:w-48 h-48 bg-surface-container rounded-2xl border-2 border-dashed border-outline-variant flex items-center justify-center flex-shrink-0 overflow-hidden relative" id="step1-img-container">
                            <span id="step1-img-icon" class="material-symbols-outlined text-4xl text-outline opacity-50">image</span>
                            <img id="step1-img" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500" alt="Sơ chế nguyên liệu" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Cooking Steps (JS populated) -->
            <div id="cooking-steps-container" class="space-y-8">
                <!-- Steps will be generated dynamically based on the dish -->
            </div>
        </div>
    </div>

    <!-- Related Suggestions Footer -->
    <section class="mt-32 pt-16 border-t border-surface-container-highest">
        <h3 class="text-3xl font-black text-on-surface mb-10 text-center tracking-tight">Có thể bạn quan tâm</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="related-foods">
            <!-- Loading ... -->
        </div>
    </section>
</div>

<!-- Floating Progress/Controls Bottom Bar -->
<div class="fixed bottom-0 left-64 right-0 z-50 p-6 pointer-events-none flex justify-center">
    <div class="bg-white/90 backdrop-blur-3xl pointer-events-auto w-full max-w-4xl rounded-full p-4 flex items-center justify-between shadow-2xl border-2 border-white">
        <div class="flex items-center gap-4 pl-4">
            <div class="h-12 w-12 rounded-full bg-surface-container flex items-center justify-center">
                <span class="material-symbols-outlined text-primary text-2xl">restaurant_menu</span>
            </div>
            <div>
                <p class="text-sm font-bold text-on-surface">Bạn đã hoàn thành các bước?</p>
                <p class="text-xs font-medium text-on-surface-variant">Hãy trình bày ra bát và thưởng thức thôi!</p>
            </div>
        </div>
        <button class="group relative flex items-center gap-3 px-10 py-4 rounded-full bg-gradient-to-r from-primary to-primary-container text-on-primary font-black text-lg shadow-lg hover:scale-105 active:scale-95 transition-all overflow-hidden" onclick="saveHistoryAndRedirect()">
            <span class="material-symbols-outlined text-2xl relative z-10">celebration</span>
            <span class="relative z-10">Hoàn thành</span>
            <div class="absolute inset-0 bg-white/20 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></div>
        </button>
<script>
  async function saveHistoryAndRedirect() {
    const foodId = '@ViewBag.FoodId';
    const userId = localStorage.getItem('userId');
    if (userId) {
        try {
          await fetch(`/api/users/${userId}/history`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ foodId })
          });
        } catch (e) { console.error('Failed to save history', e); }
    }
    // after saving, redirect to home index
    window.location.href = '/Home/History';
  }
</script>
    </div>
</div>

@section Scripts {
    <script src="/js/cookingSteps.js"></script>
    <script>
        let currentFoodId = '@ViewBag.FoodId';
        let currentFoodName = '';

        function extractOrGenerateQuantity(ingredientName) {
            const match = ingredientName.match(/(\d+(?:\.\d+)?)\s*(g|kg|ml|l|muỗng|thìa|quả|trái|tép|tán|gr)/i);
            if (match) {
                let name = ingredientName.replace(match[0], '').trim();
                name = name.replace(/^-+/, '').trim();
                return { name: name || ingredientName, qty: match[0].toLowerCase() };
            }
            let hash = 0;
            for (let i = 0; i < ingredientName.length; i++) {
                hash = ((hash << 5) - hash) + ingredientName.charCodeAt(i);
                hash |= 0;
            }
            const absHash = Math.abs(hash);
            const lower = ingredientName.toLowerCase();
            if(lower.includes('mắm') || lower.includes('đường') || lower.includes('muối') || lower.includes('tiêu') || lower.includes('dầu') || lower.includes('tỏi') || lower.includes('hành') || lower.includes('xốt') || lower.includes('tương') || lower.includes('dấm') || lower.includes('chanh')) {
                const units = ['1 muỗng', '2 muỗng', '3 muỗng', '1/2 muỗng', '1 quả', '50g', '20g'];
                return { name: ingredientName, qty: units[absHash % units.length] };
            }
            const weights = ['100g', '200g', '300g', '500g', '150g', '250g', '50g'];
            return { name: ingredientName, qty: weights[absHash % weights.length] };
        }

        class CookingTimer {
            constructor(timeId, btnId, progressId, progressTextId, iconBgId) {
                this.timeId = timeId;
                this.btnId = btnId;
                this.progressId = progressId;
                this.progressTextId = progressTextId;
                this.iconBgId = iconBgId;
                
                this.interval = null;
                this.totalSeconds = 0;
                this.currentSeconds = 0;
                this.isRunning = false;
            }

            toggle() {
                const btn = document.getElementById(this.btnId);
                const iconBg = document.getElementById(this.iconBgId);
                
                if (this.isRunning) {
                    clearInterval(this.interval);
                    this.isRunning = false;
                    btn.innerText = "Tiếp tục";
                    if (iconBg) iconBg.classList.remove('animate-pulse');
                } else {
                    if (this.totalSeconds === 0) {
                        const timeStr = document.getElementById(this.timeId).innerText;
                        const parts = timeStr.split(':');
                        if (parts.length === 2) {
                            this.totalSeconds = parseInt(parts[0]) * 60 + parseInt(parts[1]);
                            this.currentSeconds = this.totalSeconds;
                        }
                    }

                    if (this.currentSeconds > 0) {
                        this.isRunning = true;
                        btn.innerText = "Tạm dừng";
                        if (iconBg) iconBg.classList.add('animate-pulse');
                        
                        this.interval = setInterval(() => {
                            this.currentSeconds--;
                            this.updateDisplay();
                            
                            if (this.currentSeconds <= 0) {
                                clearInterval(this.interval);
                                this.isRunning = false;
                                btn.innerText = "Hoàn thành";
                                if (iconBg) iconBg.classList.remove('animate-pulse');
                                playAlarm();
                            }
                        }, 1000);
                    }
                }
            }

            updateDisplay() {
                const mins = Math.floor(this.currentSeconds / 60);
                const secs = this.currentSeconds % 60;
                document.getElementById(this.timeId).innerText = 
                    `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                    
                const progress = this.totalSeconds > 0 ? 
                    ((this.totalSeconds - this.currentSeconds) / this.totalSeconds) * 100 : 0;
                    
                if (this.progressId) {
                    document.getElementById(this.progressId).style.width = `${progress}%`;
                }
                if (this.progressTextId) {
                    document.getElementById(this.progressTextId).innerText = `${Math.floor(progress)}% Hoàn thành`;
                }
            }
        }

        // Timer cho bước 1: Sơ chế nguyên liệu
        // Đọc thời gian từ #step1-time (được set bởi renderCookingSteps)
        let prepTimer = new CookingTimer('step1-time', 'step1-timer-btn', null, null, null);
        function togglePrepTimer() {
            prepTimer.toggle();
        }

        function playAlarm() {
            try {
                const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
                audio.play();
                
                if (typeof showTopRightInfo === 'function') {
                    showTopRightInfo("Đã hết thời gian", "Đã hết thời gian! Hãy chuyển sang bước tiếp theo.");
                } else {
                    alert("Đã hết thời gian!");
                }
            } catch (e) {
                console.error("Cannot play audio", e);
            }
        }

        document.addEventListener('DOMContentLoaded', async () => {
            if (!currentFoodId) {
                document.getElementById('cook-title').innerText = "Vui lòng cung cấp ID Món ăn";
                return;
            }

            try {
                const res = await fetch(`/api/foods/${currentFoodId}`);
                if (!res.ok) throw new Error('Load failed');
                const food = await res.json();
                
                currentFoodName = food.name;
                document.getElementById('cook-title').innerText = food.name;
                document.title = "Đang nấu: " + food.name;
                
                if (food.category) {
                    document.getElementById('cook-category').innerText = food.category;
                }

                if (food.imageUrl) {
                    document.getElementById('cook-img').src = food.imageUrl;
                }

                // Generate and render dynamic cooking steps
                const stepsData = generateCookingSteps(food);
                renderCookingSteps(stepsData, food);

                // Fetch matching ingredient image for prep step
                const step1Img = document.getElementById('step1-img');
                const step1Icon = document.getElementById('step1-img-icon');

                if (food.prepImageUrl) {
                    step1Img.src = food.prepImageUrl;
                    step1Img.onload = () => {
                        step1Img.classList.remove('opacity-0');
                        if (step1Icon) step1Icon.classList.add('hidden');
                    };
                } else if (stepsData.mainIngredient) {
                    try {
                        const ingRes = await fetch("/api/foods/ingredients");
                        if (ingRes.ok) {
                            const ingData = await ingRes.json();
                            const dbIngredients = ingData.ingredients || [];
                            const lowerMain = stepsData.mainIngredient.toLowerCase();
                            // Find matching ingredient
                            const matchIng = dbIngredients.find(di => lowerMain.includes(di.name.toLowerCase()) || di.name.toLowerCase().includes(lowerMain));
                            
                            let finalImageUrl = `https://placehold.co/400x400/e0f2fe/0369a1?text=Sơ+chế%0A${encodeURIComponent(stepsData.mainIngredient)}`;

                            console.log('CookMode: mainIngredient=', stepsData.mainIngredient);
                            console.log('CookMode: dbIngredients count=', dbIngredients.length);
                            if (matchIng) {
                                console.log('CookMode: matched ingredient=', matchIng);
                                // Ưu tiên ảnh sơ chế nếu có, sau đó mới dùng ảnh chung
                                finalImageUrl = matchIng.prepImageUrl || matchIng.imageUrl || finalImageUrl;
                            }

                            console.log('CookMode: finalImageUrl=', finalImageUrl);

                            step1Img.src = finalImageUrl;
                            step1Img.onload = () => {
                                step1Img.classList.remove('opacity-0');
                                if(step1Icon) step1Icon.classList.add('hidden');
                            };
                            step1Img.onerror = () => {
                                // Hiện lại icon placeholder nếu ảnh không tải được
                                step1Img.classList.add('opacity-0');
                                if(step1Icon) step1Icon.classList.remove('hidden');
                            };

                            // Save to database
                            fetch(`/api/foods/${currentFoodId}/prep-image`, {
                                method: 'PATCH',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ imageUrl: finalImageUrl })
                            }).catch(err => console.error("Could not save prep image:", err));
                        }
                    } catch(e) { console.error("Could not load ingredient image:", e); }
                }

                const ingList = document.getElementById('cook-ingredients');
                ingList.innerHTML = '';
                
                if (food.ingredients && Array.isArray(food.ingredients)) {
                    food.ingredients.forEach((i, idx) => {
                        const parsed = extractOrGenerateQuantity(i);
                        ingList.innerHTML += `
                            <label class="flex items-center justify-between group cursor-pointer p-3 hover:bg-surface rounded-xl transition-colors">
                                <div class="flex items-center gap-4">
                                    <input class="w-6 h-6 rounded-full border-2 border-outline text-primary focus:ring-primary-container" type="checkbox"/>
                                    <span class="text-on-surface font-semibold text-base">${parsed.name} <span class="text-sky-600">(${parsed.qty})</span></span>
                                </div>
                                <button type="button" class="text-xs font-bold px-3 py-1.5 rounded-full bg-primary-container text-on-primary-container opacity-0 group-hover:opacity-100 transition-opacity">Mua nhanh</button>
                            </label>
                        `;
                    });
                }

                // Call for basic recommendation for related block
                const relRes = await fetch('/api/foods/all');
                if (relRes.ok) {
                    const allData = await relRes.json();
                    const list = allData.foods || [];
                    const related = list.sort(() => .5 - Math.random()).slice(0, 3);
                    const relContainer = document.getElementById('related-foods');
                    relContainer.innerHTML = '';
                    related.forEach(rf => {
                        relContainer.innerHTML += `
                            <div class="bg-surface-container-lowest p-5 rounded-3xl shadow-md border border-sky-50 group cursor-pointer" onclick="window.location.href='/Home/FoodDetail?id=${rf.id}'">
                                <div class="overflow-hidden rounded-2xl mb-5 relative h-48">
                                    <img alt="${rf.name}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="${rf.imageUrl || 'https://via.placeholder.com/400x300'}"/>
                                </div>
                                <h5 class="font-black text-xl text-on-surface mb-1">${rf.name}</h5>
                                <p class="text-sm text-on-surface-variant font-medium">${rf.restaurant || rf.category || 'Gợi ý cho bạn'}</p>
                            </div>
                        `;
                    });
                }

                // Set Favorite State
                setTimeout(() => {
                    const btn = document.getElementById('btn-save-recipe');
                    if (typeof applyFavoriteState === 'function') {
                        applyFavoriteState(btn, currentFoodId);
                    }
                }, 500);

                // Check health warning
                const userId = localStorage.getItem('userId');
                const isOilyFood = (food.category && food.category.toLowerCase() === "đồ ăn nhanh") ||
                                 (food.name && ['chiên', 'rán', 'dầu', 'mỡ', 'hamburger', 'pizza', 'fast food'].some(k => food.name.toLowerCase().includes(k))) ||
                                 (food.tags && food.tags.some(t => ['chiên', 'rán', 'dầu', 'mỡ', 'nhanh'].some(k => t.toLowerCase().includes(k)))) ||
                                 (food.taste && food.taste.some(t => t.toLowerCase().includes('béo')));

                if (userId && isOilyFood) {
                    try {
                        const warnRes = await fetch(`/api/users/${userId}/history`);
                        if (warnRes.ok) {
                            const warnData = await warnRes.json();
                            if (warnData.warning) {
                                setTimeout(() => {
                                    if (typeof showTopRightWarning === 'function') {
                                        showTopRightWarning(warnData.warning);
                                    }
                                }, 800);
                            }
                        }
                    } catch (e) {
                        console.error("Lỗi khi tải cảnh báo:", e);
                    }
                }

            } catch (err) {
                console.error(err);
                document.getElementById('cook-title').innerText = "Oops, có lỗi xảy ra tải dữ liệu!";
            }
        });

        function toggleFavoriteCurrent() {
            const btn = document.getElementById('btn-save-recipe');
            if (typeof toggleFavorite === 'function') {
                toggleFavorite(btn, { id: currentFoodId, name: currentFoodName });
            }
        }
    </script>
}
