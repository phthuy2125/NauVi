@{ Layout = null; }
<!DOCTYPE html>
<html class="light" lang="vi">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NauVi Admin - Thêm món ăn mới</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>

<body class="bg-[#f0f9ff] text-slate-800 min-h-screen flex">
    <!-- Sidebar Admin (NauVi Sky Glass Theme) -->
    <aside class="w-64 bg-sky-50/80 backdrop-blur-xl border-r border-sky-100 text-sky-950 flex flex-col hidden md:flex min-h-screen p-6 z-20">
        <div>
            <h1 class="text-2xl font-black text-sky-900 tracking-tighter">NauVi Admin</h1>
            <p class="text-[10px] uppercase tracking-widest text-sky-600 font-extrabold mt-1">Hệ thống quản trị viên</p>
        </div>
        <nav class="flex-1 space-y-2 mt-8">
            <a href="/Admin/ManagePosts" class="flex items-center gap-3 text-sky-700 hover:bg-sky-100/80 rounded-2xl px-4 py-3 font-semibold transition-all">
                <span class="material-symbols-outlined text-[20px]">fact_check</span>
                <span>Duyệt bài đăng</span>
            </a>
            <a href="/Admin/AddFood" class="flex items-center gap-3 bg-sky-200 text-sky-950 rounded-2xl px-4 py-3 font-bold transition-all shadow-sm">
                <span class="material-symbols-outlined text-[20px]">add_circle</span>
                <span>Thêm món ăn</span>
            </a>
            <a href="/Home/Community" class="flex items-center gap-3 text-sky-700 hover:bg-sky-100/80 rounded-2xl px-4 py-3 font-semibold transition-all">
                <span class="material-symbols-outlined text-[20px]">forum</span>
                <span>Trang cộng đồng</span>
            </a>
            <a href="/Home/Index" class="flex items-center gap-3 text-sky-700 hover:bg-sky-100/80 rounded-2xl px-4 py-3 font-semibold transition-all">
                <span class="material-symbols-outlined text-[20px]">home</span>
                <span>Về trang chủ</span>
            </a>
        </nav>
        <div class="pt-6 border-t border-sky-200/60 flex items-center justify-between text-xs text-sky-600">
            <span>NauVi v2.0 • Admin</span>
            <button onclick="logoutAdmin()" title="Đăng xuất" class="hover:text-rose-600 transition-colors p-1 rounded-lg hover:bg-rose-50">
                <span class="material-symbols-outlined text-base">logout</span>
            </button>
        </div>
    </aside>

    <!-- Content -->
    <main class="flex-1 p-6 md:p-10 overflow-y-auto">
        <div class="max-w-4xl mx-auto">
            <div class="mb-8">
                <div class="flex items-center gap-2 mb-1">
                    <span class="px-2.5 py-0.5 bg-sky-100 text-sky-700 rounded-full text-[11px] font-bold uppercase tracking-wider">Cơ sở dữ liệu</span>
                </div>
                <h2 class="text-3xl font-black text-sky-950 tracking-tight">Thêm món ăn mới</h2>
                <p class="text-sky-700/80 text-sm mt-1">Điền thông tin chi tiết và hình ảnh để bổ sung món ăn vào thư viện công thức NauVi.</p>
            </div>
            
            <form id="add-food-form" class="bg-white p-8 md:p-10 rounded-3xl border border-sky-100 shadow-xl shadow-sky-950/5 space-y-6">
                <!-- Tên món & Tên Tiếng Anh -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-2">Tên món ăn <span class="text-rose-500">*</span></label>
                        <input type="text" id="name" required class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm py-3 px-4 transition-all" placeholder="VD: Phở Bò Tái Chín">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-2">Tên Tiếng Anh</label>
                        <input type="text" id="nameEn" class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm py-3 px-4 transition-all" placeholder="VD: Beef Pho">
                    </div>
                </div>

                <!-- Tên Nhà hàng -->
                <div>
                    <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-2">Nhà hàng / Quán gợi ý</label>
                    <input type="text" id="restaurant" class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm py-3 px-4 transition-all" placeholder="VD: Phở Thìn Hà Nội">
                </div>

                <!-- Mô tả -->
                <div>
                    <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-2">Mô tả món ăn <span class="text-rose-500">*</span></label>
                    <textarea id="description" required rows="3" class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm p-4 transition-all" placeholder="Mô tả hương vị, đặc trưng và cảm nhận của món ăn..."></textarea>
                </div>

                <!-- Giá tham khảo -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-sky-50/50 p-6 rounded-2xl border border-sky-100">
                    <div>
                        <label class="block text-xs font-bold text-sky-800 mb-2 flex items-center gap-2">
                            <span class="w-5 h-5 rounded-full bg-sky-600 flex items-center justify-center text-white text-[10px] font-bold">C</span>
                            Giá gốc Coopmart <span class="text-rose-500">*</span>
                        </label>
                        <input type="number" id="basePriceCoop" required class="w-full rounded-xl border-sky-200 bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 text-sm py-2.5 px-3.5" placeholder="VD: 65000">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-teal-800 mb-2 flex items-center gap-2">
                            <span class="w-5 h-5 rounded-full bg-teal-600 flex items-center justify-center text-white text-[10px] font-bold">B</span>
                            Giá gốc Bách Hóa Xanh <span class="text-rose-500">*</span>
                        </label>
                        <input type="number" id="basePriceBHX" required class="w-full rounded-xl border-sky-200 bg-white focus:border-teal-500 focus:ring-teal-500/20 text-sky-950 text-sm py-2.5 px-3.5" placeholder="VD: 62000">
                    </div>
                </div>

                <!-- Phân loại & Tags -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-2">Danh mục (Category)</label>
                        <input type="text" id="category" class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm py-3 px-4 transition-all" placeholder="VD: Phở, Bún, Cơm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-2">Thẻ tag (Ngăn cách bằng dấu phẩy)</label>
                        <input type="text" id="tags" class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm py-3 px-4 transition-all" placeholder="VD: thanh đạm, ít calo, bữa tối">
                    </div>
                </div>

                <!-- Hình ảnh đa năng -->
                <div class="pt-4 border-t border-sky-100">
                    <label class="block text-xs font-bold text-sky-900 uppercase tracking-wider mb-4">Hình ảnh món ăn <span class="text-rose-500">*</span></label>
                    
                    <div class="flex gap-3 mb-4">
                        <button type="button" id="btn-tab-url" class="px-4 py-2 font-bold text-xs rounded-xl bg-sky-600 text-white shadow-md shadow-sky-600/20 transition-all" onclick="switchImageTab('url')">Sử dụng Link ảnh (URL)</button>
                        <button type="button" id="btn-tab-upload" class="px-4 py-2 font-bold text-xs rounded-xl bg-sky-100/70 text-sky-700 hover:bg-sky-100 transition-all" onclick="switchImageTab('upload')">Tải ảnh từ thiết bị</button>
                    </div>

                    <!-- Tab URL -->
                    <div id="tab-url" class="block">
                        <input type="url" id="imageUrl" class="w-full rounded-2xl border-sky-200/80 bg-sky-50/40 focus:bg-white focus:border-sky-500 focus:ring-sky-500/20 text-sky-950 placeholder:text-sky-400 text-sm py-3 px-4 transition-all" placeholder="https://images.unsplash.com/... (Nên dùng ảnh tỉ lệ 4:3 rõ nét)">
                    </div>

                    <!-- Tab Upload -->
                    <div id="tab-upload" class="hidden">
                        <div class="flex items-center justify-center w-full">
                            <label for="imageFile" class="flex flex-col items-center justify-center w-full h-36 border-2 border-dashed border-sky-200 hover:border-sky-400 rounded-2xl cursor-pointer bg-sky-50/40 hover:bg-sky-50 transition-all">
                                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                    <div class="w-10 h-10 rounded-full bg-sky-100 text-sky-600 flex items-center justify-center mb-2">
                                        <span class="material-symbols-outlined text-2xl">cloud_upload</span>
                                    </div>
                                    <p class="text-xs text-sky-700 font-bold" id="file-name-display">Nhấp để chọn file ảnh (< 5MB)</p>
                                    <p class="text-[10px] text-sky-500 mt-1">Định dạng hỗ trợ: JPG, PNG, WEBP</p>
                                </div>
                                <input id="imageFile" type="file" class="hidden" accept="image/*" onchange="document.getElementById('file-name-display').innerText = this.files[0].name" />
                            </label>
                        </div>
                    </div>
                </div>

                <div id="error-message" class="hidden p-4 rounded-2xl bg-rose-50 text-rose-700 font-semibold text-xs border border-rose-200"></div>

                <!-- Bấm tạo -->
                <div class="flex items-center justify-end pt-6 border-t border-sky-100 gap-4">
                    <button type="reset" class="px-6 py-3 rounded-full font-bold text-xs text-sky-700 hover:bg-sky-100/80 transition-colors">Đặt lại</button>
                    <button type="submit" id="submit-btn" class="px-8 py-3.5 rounded-full font-bold text-xs text-white bg-gradient-to-r from-sky-600 to-cyan-600 hover:from-sky-500 hover:to-cyan-500 shadow-xl shadow-sky-600/25 active:scale-95 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-base">add_task</span>
                        <span>Tạo món ăn</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <!-- Toast Component -->
    <div id="toast" class="fixed bottom-10 right-10 bg-sky-950 text-white px-6 py-4 rounded-2xl shadow-2xl font-bold flex items-center gap-3 border border-sky-800 transition-all duration-300 transform translate-y-20 opacity-0 pointer-events-none z-50">
        <span class="material-symbols-outlined text-emerald-400">check_circle</span>
        <span id="toast-msg">Đã thêm thành công!</span>
    </div>

    <!-- Script xử lý -->
    <script>
        // Check quyền ở Client
        document.addEventListener('DOMContentLoaded', () => {
            const token = localStorage.getItem("token");
            if (!token) {
                alert("Vui lòng đăng nhập để truy cập trang quản trị!");
                window.location.href = "/Account/Login";
            }
        });

        // Xử lý Tab ẩn hiện
        let isUploadMode = false;
        function switchImageTab(mode) {
            isUploadMode = (mode === 'upload');
            const tabUpload = document.getElementById('tab-upload');
            const tabUrl = document.getElementById('tab-url');
            const btnUpload = document.getElementById('btn-tab-upload');
            const btnUrl = document.getElementById('btn-tab-url');
            
            if (isUploadMode) {
                tabUpload.classList.remove('hidden');
                tabUrl.classList.add('hidden');
                
                btnUpload.className = "px-4 py-2 font-bold text-xs rounded-xl bg-sky-600 text-white shadow-md shadow-sky-600/20 transition-all";
                btnUrl.className = "px-4 py-2 font-bold text-xs rounded-xl bg-sky-100/70 text-sky-700 hover:bg-sky-100 transition-all";
            } else {
                tabUrl.classList.remove('hidden');
                tabUpload.classList.add('hidden');
                
                btnUrl.className = "px-4 py-2 font-bold text-xs rounded-xl bg-sky-600 text-white shadow-md shadow-sky-600/20 transition-all";
                btnUpload.className = "px-4 py-2 font-bold text-xs rounded-xl bg-sky-100/70 text-sky-700 hover:bg-sky-100 transition-all";
            }
        }

        // Xử lý nộp Form
        const form = document.getElementById('add-food-form');
        const submitBtn = document.getElementById('submit-btn');
        const errorMsg = document.getElementById('error-message');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorMsg.classList.add('hidden');
            
            // Thay đổi nút submitting
            submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">cycle</span> Đang xử lý...';
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-70');

            const token = localStorage.getItem("token");
            try {
                let bodyData;
                let fetchHeaders = {
                    "Authorization": `Bearer ${token}`
                };

                if (isUploadMode) {
                    // DÙNG FORMDATA (vừa file, vừa text)
                    const formData = new FormData();
                    formData.append("name", document.getElementById('name').value);
                    formData.append("nameEn", document.getElementById('nameEn').value);
                    formData.append("restaurant", document.getElementById('restaurant').value);
                    formData.append("description", document.getElementById('description').value);
                    formData.append("basePriceCoop", document.getElementById('basePriceCoop').value);
                    formData.append("basePriceBHX", document.getElementById('basePriceBHX').value);
                    formData.append("category", document.getElementById('category').value);
                    formData.append("tags", document.getElementById('tags').value);
                    
                    const fileInput = document.getElementById('imageFile');
                    if (fileInput.files.length > 0) {
                        formData.append("imageFile", fileInput.files[0]);
                    } else {
                        throw new Error("Vui lòng chọn hình ảnh để tải lên");
                    }
                    
                    bodyData = formData; // fetch sẽ tự sinh Content-Type multipart/form-data
                } else {
                    // DÙNG JSON
                    const imageUrl = document.getElementById('imageUrl').value;
                    if (!imageUrl) throw new Error("Vui lòng nhập đường link hình ảnh");

                    const jsonData = {
                        name: document.getElementById('name').value,
                        nameEn: document.getElementById('nameEn').value,
                        restaurant: document.getElementById('restaurant').value,
                        description: document.getElementById('description').value,
                        basePriceCoop: document.getElementById('basePriceCoop').value,
                        basePriceBHX: document.getElementById('basePriceBHX').value,
                        category: document.getElementById('category').value,
                        tags: document.getElementById('tags').value,
                        imageUrl: imageUrl
                    };
                    bodyData = JSON.stringify(jsonData);
                    fetchHeaders["Content-Type"] = "application/json";
                }

                const res = await fetch('/api/foods', {
                    method: 'POST',
                    headers: fetchHeaders,
                    body: bodyData
                });

                const data = await res.json();

                if (res.ok) {
                    showToast("Đã thêm " + data.food.name + " thành công!");
                    form.reset();
                    document.getElementById('file-name-display').innerText = "Nhấp để chọn file ảnh (< 5MB)";
                } else {
                    throw new Error(data.message || data.error || "Có lỗi từ máy chủ");
                }
            } catch (err) {
                errorMsg.innerText = "Lỗi: " + err.message;
                errorMsg.classList.remove('hidden');
            } finally {
                submitBtn.innerHTML = '<span class="material-symbols-outlined text-base">add_task</span> <span>Tạo món ăn</span>';
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-70');
            }
        });

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function logoutAdmin() {
            localStorage.clear();
            window.location.href = "/Account/Login";
        }
    </script>
</body>
</html>
