{
  "MongoSettings": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "DatabaseName": "food_system"
  },
  "Jwt": {
    "Secret": "your-jwt-secret-key-at-least-32-characters-long"
  },
  "GoogleAuth": {
    "ClientId": "your-google-client-id.apps.googleusercontent.com"
  },
  "NauVi": {
    "EnablePriceUpdaterHostedService": false,
    "SeedOnStartup": false,
    "ScraperApiKey": "your-scraper-api-key"
  },
  "FoodWise": {
    "EnablePriceUpdaterHostedService": false,
    "SeedOnStartup": false,
    "ScraperApiKey": "your-scraper-api-key"
  },
  "AiImageService": {
    "BaseUrl": "http://127.0.0.1:8001",
    "TimeoutSeconds": 25,
    "UncertainThreshold": 0.5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GEMINI_API_KEY": "YOUR_GEMINI_API_KEY_HERE",
  "AllowedHosts": "*",
  "COPILOT_API_KEY": "YOUR_COPILOT_API_KEY_HERE"
}
