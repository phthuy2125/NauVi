# ==============================================================================
# File cấu hình biến môi trường mẫu cho NauVi (Docker Compose)
# Hướng dẫn: Sao chép file này thành .env và chỉnh sửa các giá trị mong muốn:
#   cp .env.example .env
# ==============================================================================

# Cổng truy cập ứng dụng web trên máy host (Mặc định: 7200 -> http://localhost:7200)
PORT=7200

# ------------------------------------------------------------------------------
# Chế độ AI (FastAPI Service)
# ------------------------------------------------------------------------------
# - AI_MODE=mock: Trả về kết quả dự đoán giả lập cố định (Dùng cho CI, chấm bài, chạy thử không cần key).
# - AI_MODE=real: Gọi mô hình Gemini thật qua Google AI Studio API (CẦN điền GEMINI_API_KEY bên dưới).
AI_MODE=mock

# Khóa API Google Gemini (Bắt buộc nếu AI_MODE=real, lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# Dữ liệu mẫu (Seed Data)
# ------------------------------------------------------------------------------
# Tự động nạp 30 món ăn mẫu chuẩn vào MongoDB khi container web khởi động lần đầu
SEED_ON_STARTUP=true

# ------------------------------------------------------------------------------
# Bảo mật & Xác thực (JWT & Google OAuth)
# ------------------------------------------------------------------------------
# Khóa bí mật ký JWT (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=NauViSuperSecretJwtKeyAtLeast32CharsLong!

# Google OAuth Client ID dùng để xác thực đăng nhập Google
GOOGLE_CLIENT_ID=922860268029-nf97erjuv87dtfuqpdq6decjglkrs38p.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Cấu hình gửi Mail (SMTP - Tuỳ chọn)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
